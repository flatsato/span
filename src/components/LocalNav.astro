---
/**
 * ローカルナビ（サイドバー）
 * 2 カラムページのサイド。カテゴリ一覧などに使う。
 */
import type { NavItem } from "@/config/site";

interface Props {
  title?: string;
  items: NavItem[];
}

const { title, items } = Astro.props;
const currentPath = Astro.url.pathname;
---

<nav class="localNav" aria-label={title ?? "サイドナビゲーション"}>
  {title && <p class="localNav__title">{title}</p>}
  <ul class="localNav__list" role="list">
    {
      items.map((item) => (
        <li>
          <a
            class="localNav__link"
            href={item.href}
            aria-current={currentPath === item.href ? "page" : undefined}
            {...(item.external && { target: "_blank", rel: "noopener noreferrer" })}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .localNav__title {
    padding-block-end: var(--space-2xs);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-heading);
    border-block-end: 2px solid var(--color-primary);
  }

  .localNav__link {
    display: block;
    padding: var(--space-xs) var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
    border-block-end: 1px solid var(--color-border);
    transition:
      color 0.2s ease,
      padding-inline-start 0.2s ease;
  }

  .localNav__link:hover {
    padding-inline-start: var(--space-sm);
    color: var(--color-primary);
  }

  .localNav__link[aria-current="page"] {
    font-weight: var(--weight-bold);
    color: var(--color-primary);
  }
</style>
