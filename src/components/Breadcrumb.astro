---
/**
 * パンくずリスト
 * items を渡すと表示＋ JSON-LD（BreadcrumbList）を自動生成する。
 * 末尾は現在地（リンクなし）想定。
 */
import { site } from "@/config/site";

export type Crumb = { label: string; href?: string };

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const home: Crumb = { label: "ホーム", href: "/" };
const crumbs = [home, ...items];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, site.url).href } : {}),
  })),
};
---

<nav class="breadcrumb" aria-label="パンくずリスト">
  <ol class="breadcrumb__list container" role="list">
    {
      crumbs.map((c, i) => (
        <li class="breadcrumb__item">
          {c.href && i < crumbs.length - 1 ? (
            <a class="breadcrumb__link" href={c.href}>
              {c.label}
            </a>
          ) : (
            <span aria-current="page">{c.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

<style>
  .breadcrumb {
    padding-block: var(--space-sm);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .breadcrumb__item {
    display: inline-flex;
    align-items: center;
  }

  /* 区切り「/」 */
  .breadcrumb__item:not(:first-child)::before {
    margin-inline: var(--space-2xs);
    color: var(--color-border-strong);
    content: "/";
  }

  .breadcrumb__link {
    color: var(--color-link);
    text-decoration: none;
  }

  .breadcrumb__link:hover {
    text-decoration: underline;
  }
</style>
