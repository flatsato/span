---
/**
 * ボタン / ボタン型リンク
 * href があれば <a>、なければ <button>。
 * variant: solid（既定） / outline / ghost
 * size:    sm / md（既定） / lg
 * 外部リンクは external で target=_blank rel=noopener を付与。
 */
interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: "solid" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  external?: boolean;
  block?: boolean;
  class?: string;
}

const {
  href,
  type = "button",
  variant = "solid",
  size = "md",
  external = false,
  block = false,
  class: className,
} = Astro.props;

const Tag = href ? "a" : "button";
const classList = ["btn", `-${variant}`, `-${size}`, block && "-block", className];
const extra = href
  ? external
    ? { href, target: "_blank", rel: "noopener noreferrer" }
    : { href }
  : { type };
---

<Tag class:list={classList} {...extra}>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    gap: var(--space-2xs);
    align-items: center;
    justify-content: center;
    font-family: inherit;
    font-weight: var(--weight-medium);
    line-height: var(--leading-none);
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  /* サイズ */
  .btn.-sm {
    padding: var(--space-2xs) var(--space-sm);
    font-size: var(--text-sm);
  }
  .btn.-md {
    padding: var(--space-xs) var(--space-lg);
    font-size: var(--text-base);
  }
  .btn.-lg {
    padding: var(--space-sm) var(--space-xl);
    font-size: var(--text-md);
  }

  .btn.-block {
    display: flex;
    width: 100%;
  }

  /* solid */
  .btn.-solid {
    color: var(--color-text-invert);
    background-color: var(--color-primary);
  }
  .btn.-solid:hover {
    background-color: var(--color-primary-hover);
  }
  .btn.-solid:active {
    background-color: var(--color-primary-active);
  }

  /* outline */
  .btn.-outline {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
  .btn.-outline:hover {
    color: var(--color-text-invert);
    background-color: var(--color-primary);
  }

  /* ghost */
  .btn.-ghost {
    color: var(--color-primary);
  }
  .btn.-ghost:hover {
    background-color: var(--color-bg-muted);
  }

  .btn:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }
</style>
