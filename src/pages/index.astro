---
/**
 * 制作ページ一覧（開発用ダッシュボード）
 * 旧 index.ejs の Bootstrap テーブルを置き換え。納品時は削除する。
 */
import BaseLayout from "@layouts/BaseLayout.astro";

type Status = "todo" | "wip" | "review" | "done";

const statusLabel: Record<Status, string> = {
  todo: "未着手",
  wip: "作業中",
  review: "検証中",
  done: "完了",
};

const pages: { title: string; href: string; status: Status; note?: string }[] = [
  { title: "TOP", href: "/samples/top/", status: "todo" },
  { title: "ベース 1カラム", href: "/samples/base-1col/", status: "todo" },
  { title: "ベース 2カラム", href: "/samples/base-2col/", status: "todo" },
  { title: "FAQ", href: "/samples/faq/", status: "todo" },
  { title: "プライバシーポリシー", href: "/samples/privacy/", status: "todo" },
  { title: "フォーム", href: "/samples/form/", status: "todo" },
  { title: "記事詳細（single）", href: "/samples/single/", status: "todo" },
  { title: "一覧（カード）", href: "/samples/archive-card/", status: "todo" },
  { title: "一覧（リスト）", href: "/samples/archive-list/", status: "todo" },
  { title: "404 Not Found", href: "/404.html", status: "todo" },
];
---

<BaseLayout title="制作ページ一覧" noindex bodyClass="indexPage">
  <div class="container -wide dashboard">
    <h1>制作ページ一覧</h1>
    <p class="dashboard__lead">スターターキットに含まれるサンプルページの索引です。</p>

    <ul class="dashboard__grid" role="list">
      {
        pages.map((p) => (
          <li class="dashboard__card">
            <a class="dashboard__link" href={p.href}>
              <span class={`dashboard__badge -${p.status}`}>{statusLabel[p.status]}</span>
              <span class="dashboard__title">{p.title}</span>
              <span class="dashboard__path">{p.href}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <style>
    .dashboard {
      padding-block: var(--space-section);
    }

    .dashboard__lead {
      margin-block-start: var(--space-sm);
      color: var(--color-text-muted);
    }

    .dashboard__grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
      gap: var(--space-md);
      margin-block-start: var(--space-xl);
    }

    .dashboard__link {
      display: grid;
      gap: var(--space-3xs);
      height: 100%;
      padding: var(--space-md);
      text-decoration: none;
      background-color: var(--color-bg-subtle);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease;
    }

    .dashboard__link:hover {
      border-color: var(--color-primary);
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }

    .dashboard__badge {
      justify-self: start;
      padding: 0.1em 0.6em;
      font-size: var(--text-xs);
      font-weight: var(--weight-medium);
      color: var(--color-text-invert);
      border-radius: var(--radius-full);
    }

    .dashboard__badge.-todo {
      background-color: var(--color-danger);
    }
    .dashboard__badge.-wip {
      background-color: var(--color-success);
    }
    .dashboard__badge.-review {
      background-color: var(--color-info);
    }
    .dashboard__badge.-done {
      background-color: var(--color-gray-500);
    }

    .dashboard__title {
      font-size: var(--text-md);
      font-weight: var(--weight-bold);
      color: var(--color-heading);
    }

    .dashboard__path {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-text-muted);
    }
  </style>
</BaseLayout>
